# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# --- eToro ------------------------------------------------------------------------------
# Se crean en eToro: Configuración > API (o en api-portal.etoro.com).
# Para la cuenta demo genera las llaves con entorno "Virtual/Demo"; para la real, entorno "Real".
# Permisos: lectura para analizar; lectura + escritura para que el bot pueda operar.
ETORO_API_KEY=
ETORO_USER_KEY=

# Para operar con DINERO REAL (cuenta = "real") escribe exactamente: si
# Déjalo vacío mientras pruebas en papel o demo.
ETORO_CONFIRMO_DINERO_REAL=

# --- Noticias con IA (opcional) ---------------------------------------------------------
# Sin esto el bot lee las noticias con palabras clave. Se crea en platform.claude.com.
ANTHROPIC_API_KEY=

# --- Telegram: avisos y control remoto (opcional, recomendado) ---------------------------
# 1. En Telegram, háblale a @BotFather, envía /newbot y copia el token que te da.
# 2. Ábrele chat a TU bot nuevo y envíale /start (un bot no puede escribirte primero).
# 3. Háblale a @userinfobot: el número "Id" que contesta es tu chat id.
# El agente te avisa ahí y SOLO obedece comandos que vengan de ese chat id.
# Prueba con:  python -m bot_trader probar-telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Archivo de configuración (por defecto config/estrategia.toml)
# BOT_CONFIG=config/estrategia.toml
