# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# Base de datos (SQLite en el piloto; para PostgreSQL: postgresql+psycopg://usuario:clave@host/db)
DATABASE_URL=sqlite:///citas.db

# WhatsApp Cloud API (Meta). Sin WA_ACCESS_TOKEN no se envía nada: los mensajes solo se registran en el log.
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=elige-una-frase-larga-y-secreta
WA_API_VERSION=v24.0
# Solo para desarrollo local sin WA_APP_SECRET:
# ALLOW_UNSIGNED_WEBHOOKS=1

# Panel: genera uno con  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# En producción (con HTTPS) pon 1 para que la cookie solo viaje cifrada
SECURE_COOKIES=0

# Recordatorios (tarea interna, revisa cada 60 s)
RUN_SCHEDULER=1
SCHEDULER_INTERVAL_SECONDS=60
